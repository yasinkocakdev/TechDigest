<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="11.0.0" />
    <!-- MailKit/MimeKit'in çektiği 10.0.0 sürümünde bilinen açık var (GHSA-846f-f764-76mx): yamalı sürüme sabitle. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="config\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
